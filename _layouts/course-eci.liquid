<!doctype html>
<html lang="{{ site.lang }}">
<head>
{% include course-eci-head.liquid %}
</head>

<body>
  <!-- ════════ ECI Navbar ════════ -->
  <nav class="eci-navbar"{% if page.accent %} style="--global-theme-color: {{ page.accent }}; --global-hover-color: {{ page.accent }};"{% endif %}>
    <div class="navbar-inner">
      <a href="{{ page.url | relative_url }}" class="site-title">{{ page.course_number }} · {{ page.semester }}</a>
      <button class="mobile-toggle" aria-label="Toggle navigation" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
      <div class="nav-links">
        <a href="#overview" class="eci-nav-link active" data-section="overview">Overview</a>
        <a href="#schedule" class="eci-nav-link" data-section="schedule">Schedule</a>
        <a href="#materials" class="eci-nav-link" data-section="materials">Materials</a>
        <a href="#evaluation" class="eci-nav-link" data-section="evaluation">Evaluation</a>
        <a href="#policies" class="eci-nav-link" data-section="policies">Policies</a>
        <a href="{{ '/teaching/' | relative_url }}" class="back-link">← Back</a>
      </div>
    </div>
  </nav>

  <div class="eci-container"{% if page.accent %} style="--global-theme-color: {{ page.accent }}; --global-hover-color: {{ page.accent }};"{% endif %}>

    <!-- ════════ Hero ════════ -->
    <div class="eci-hero">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h1>{{ page.title }}</h1>
          <div class="subtitle">{{ page.description }}</div>
          <div class="meta">
            <span><i class="fas fa-hashtag"></i>{{ page.course_number }}</span>
            <span><i class="fas fa-calendar-alt"></i>{{ page.semester }}</span>
            <span><i class="fas fa-map-marker-alt"></i>{{ page.location }}</span>
            <span><i class="fas fa-calendar-day"></i>{{ page.day }}, {{ page.time }}</span>
          </div>
        </div>
        <div class="col-md-4 mt-3 mt-md-0" style="display:flex; flex-direction:column; align-items:center;">
          {% if page.logo %}
            <img src="{{ page.logo | relative_url }}" alt="{{ page.title }} logo" class="eci-logo">
          {% endif %}
          {% if page.syllabus %}
            <a href="{{ page.syllabus | relative_url }}" class="btn-eci btn-eci-sm" target="_blank" rel="noopener noreferrer" style="margin-top: 0.8rem;">
              <i class="fas fa-file-pdf"></i> Syllabus PDF
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- ════════ OVERVIEW ════════ -->
    <div class="eci-section active" id="section-overview">

      <div class="course-details">
        <div class="row">
          <div class="col-md-8">
            {{ content }}
          </div>
          <div class="col-md-4">
            <h2>Course Details</h2>
            <ul class="info-list">
              {% if page.semester_dates %}
                <li><i class="fas fa-calendar-alt"></i> {{ page.semester_dates }}</li>
              {% endif %}
              <li><i class="fas fa-calendar-day"></i> {{ page.day }}</li>
              <li><i class="fas fa-clock"></i> {{ page.time }}</li>
              <li><i class="fas fa-map-marker-alt"></i> {{ page.location }}</li>
            </ul>
            {% if page.communication %}
              <h2 class="mt-4">Communication</h2>
              <p style="font-size: 0.9rem; line-height: 1.6;">{{ page.communication }}</p>
            {% endif %}

            {% if page.updates %}
              <h2 class="mt-4">What's New</h2>
              {% if page.updates_note %}
                <p style="font-size: 0.85rem; line-height: 1.55; color: #555;">{{ page.updates_note }}</p>
              {% endif %}
              <div style="max-height: 240px; overflow-y: auto; padding: 0.5rem 0.75rem; border: 1px solid #e5e5e5; border-radius: 4px; background: #fafafa; margin-top: 0.5rem;">
                <ul style="font-size: 0.85rem; line-height: 1.55; padding-left: 1.1rem; margin: 0;">
                  {% for update in page.updates %}
                    <li style="margin-bottom: 0.5rem;">{{ update.text }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

          </div>
        </div>
      </div>

      <!-- Topics Covered -->
      {% if page.features %}
        <div style="padding: 2rem 0;">
          <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1.5rem;">Topics Covered</h2>
          <div class="row">
            {% for feature in page.features %}
              <div class="{% if page.features.size == 4 %}col-md-3{% else %}col-md-4{% endif %} mb-3">
                <div class="card h-100 border-0 shadow-sm">
                  <div class="card-body feature-card">
                    {% if feature.icon_svg %}{% include icons/{{ feature.icon_svg }}.svg %}{% else %}<i class="{{ feature.icon }} fa-2x"></i>{% endif %}
                    <h5>{{ feature.title }}</h5>
                    <p>{{ feature.description }}</p>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <!-- Video Lectures -->
      {% if page.videos %}
        <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem;">Video Lectures</h2>
        <div class="row">
          {% for video in page.videos %}
          <div class="video-card">
            <h6>{{ video.title }}</h6>
            <div class="video-responsive">
              {% assign vid_id = video.id | downcase %}
              {% if vid_id contains 'pl' or vid_id contains 'list=' %}
                <iframe src="https://www.youtube.com/embed/videoseries?list={{ video.id }}" allowfullscreen title="{{ video.title }}"></iframe>
              {% else %}
                <iframe src="https://www.youtube.com/embed/{{ video.id }}" allowfullscreen title="{{ video.title }}"></iframe>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- ════════ SCHEDULE ════════ -->
    <div class="eci-section" id="section-schedule">
      <div class="toc-layout">
        <nav class="toc-nav" id="schedule-toc">
          <div class="toc-nav-title">On this page</div>
          <ul id="schedule-toc-list"></ul>
        </nav>
        <div class="toc-content" id="schedule-content">
          {% if page.schedule_content %}
            {{ page.schedule_content | markdownify }}
          {% else %}
            <p><em>Schedule will be posted before the first class.</em></p>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- ════════ MATERIALS ════════ -->
    <div class="eci-section" id="section-materials">
      {% if page.materials %}
        <h2>Lecture Slides &amp; Handouts</h2>
        <ul class="materials-list">
          {% for item in page.materials %}
            <li>
              <span>{{ item.title }}</span>
              <span class="materials-buttons">
                {% if item.handout_url %}
                  <a href="{{ item.handout_url | relative_url }}" target="_blank" class="btn-eci btn-eci-sm" rel="noopener noreferrer">
                    <i class="fas fa-file-alt"></i> Handout
                  </a>
                {% endif %}
                {% if item.script_url %}
                  <a href="{{ item.script_url | relative_url }}" download class="btn-eci btn-eci-sm">
                    <i class="fab fa-r-project"></i> R script
                  </a>
                {% endif %}
                {% if item.url %}
                  <a href="{{ item.url | relative_url }}" target="_blank" class="btn-eci btn-eci-sm" rel="noopener noreferrer">
                    <i class="fas fa-chalkboard-teacher"></i> Slides
                  </a>
                {% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if page.written_notes %}
        <hr>
        <h2>Written Notes</h2>
        <p style="font-size: 0.9rem; color: #666; margin-bottom: 0.8rem;">Detailed notes in article format, covering material discussed in class and beyond.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          {% for note in page.written_notes %}
            <a href="{{ note.url | relative_url }}" target="_blank" class="btn-eci btn-eci-sm" rel="noopener noreferrer" style="white-space: nowrap;">
              <i class="fas fa-book"></i> {{ note.title }}
            </a>
          {% endfor %}
        </div>
      {% endif %}

      {% if page.textbooks_content %}
        <hr>
        {{ page.textbooks_content | markdownify }}
      {% endif %}
    </div>

    <!-- ════════ EVALUATION ════════ -->
    <div class="eci-section" id="section-evaluation">
      <div class="toc-layout">
        <nav class="toc-nav" id="eval-toc">
          <div class="toc-nav-title">On this page</div>
          <ul id="eval-toc-list"></ul>
        </nav>
        <div class="toc-content" id="eval-content">
          {% if page.assignments_content %}
            {{ page.assignments_content | markdownify }}
          {% else %}
            <p><em>Evaluation details will be posted before the first class.</em></p>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- ════════ POLICIES ════════ -->
    <div class="eci-section" id="section-policies">
      {% if page.policies_content %}
        {{ page.policies_content | markdownify }}
      {% else %}
        <p><em>Please refer to the Syllabus PDF for course policies.</em></p>
      {% endif %}
    </div>

    <!-- Footer -->
    <footer class="eci-footer">
      {{ page.title }} · {{ page.semester }} · <a href="{{ '/teaching/' | relative_url }}">Jaewon Yoo</a> · National Tsing Hua University
    </footer>

  </div>

  <!-- Photo Lightbox -->
  <div id="eciPhotoLightbox">
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox-img" id="eciLightboxImg" src="" alt="">
  </div>

  <!-- Scripts -->
  <script src="{{ site.third_party_libraries.jquery.url.js }}" integrity="{{ site.third_party_libraries.jquery.integrity.js }}" crossorigin="anonymous"></script>
  <script src="{{ '/assets/js/bootstrap.bundle.min.js' | relative_url }}"></script>
  <script src="{{ site.third_party_libraries.mdb.url.js }}" integrity="{{ site.third_party_libraries.mdb.integrity.js }}" crossorigin="anonymous"></script>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    var links = document.querySelectorAll('.eci-nav-link');
    var sections = document.querySelectorAll('.eci-section');

    links.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var target = this.getAttribute('data-section');

        // Update nav
        links.forEach(function(l) { l.classList.remove('active'); });
        this.classList.add('active');

        // Update sections
        sections.forEach(function(s) { s.classList.remove('active'); });
        var el = document.getElementById('section-' + target);
        if (el) el.classList.add('active');

        // Close mobile menu
        document.querySelector('.nav-links').classList.remove('open');

        // Update URL hash, and remember the tab for reloads
        history.replaceState(null, null, '#' + target);
        try { sessionStorage.setItem('courseSection', target); } catch (err) {}

        // Scroll to top
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    // Handle initial hash; on a reload without a hash, restore the last tab
    var hash = window.location.hash.replace('#', '');
    if (!hash) {
      var navEntry = performance.getEntriesByType ? performance.getEntriesByType('navigation')[0] : null;
      var isReload = navEntry ? navEntry.type === 'reload' : (performance.navigation && performance.navigation.type === 1);
      if (isReload) { try { hash = sessionStorage.getItem('courseSection') || ''; } catch (err) {} }
    }
    if (hash) {
      var targetLink = document.querySelector('.eci-nav-link[data-section="' + hash + '"]');
      if (targetLink) targetLink.click();
    }

    // ── Shared TOC builder ──
    function buildToc(contentId, tocListId, headingSelector, idPrefix) {
      var content = document.getElementById(contentId);
      var list = document.getElementById(tocListId);
      if (!content || !list) return;
      var headings = content.querySelectorAll(headingSelector);
      headings.forEach(function(h, i) {
        var id = idPrefix + '-' + i;
        h.setAttribute('id', id);
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + id;
        a.textContent = h.textContent;
        a.addEventListener('click', function(e) {
          e.preventDefault();
          h.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        li.appendChild(a);
        list.appendChild(li);
      });
      var tocLinks = list.querySelectorAll('a');
      window.addEventListener('scroll', function() {
        var activeIdx = 0;
        if ((window.innerHeight + window.scrollY) >= (document.body.scrollHeight - 50)) {
          activeIdx = headings.length - 1;
        } else {
          headings.forEach(function(h, i) {
            var rect = h.getBoundingClientRect();
            if (rect.top <= 120) activeIdx = i;
          });
        }
        tocLinks.forEach(function(a, i) {
          a.classList.toggle('active', i === activeIdx);
        });
      });
    }

    // Schedule TOC: from h3 headings (Part I, II, III, IV)
    buildToc('schedule-content', 'schedule-toc-list', 'h3', 'sched');

    // Evaluation TOC: from h2 headings
    buildToc('eval-content', 'eval-toc-list', 'h2', 'eval');
  });
  </script>
  <script>
  (function() {
    var lightbox = document.getElementById('eciPhotoLightbox');
    var lightboxImg = document.getElementById('eciLightboxImg');
    var closeBtn = lightbox.querySelector('.lightbox-close');

    document.querySelectorAll('.photo-clickable').forEach(function(img) {
      img.addEventListener('click', function() {
        lightboxImg.src = this.getAttribute('data-full') || this.src;
        lightboxImg.alt = this.alt;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeLightbox() {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    }

    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeLightbox();
    });
  })();
  </script>
{% if site.enable_google_analytics %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    // Local previews (localhost, 127.0.0.1) must not reach the GA4 property.
    if (!/\.github\.io$/.test(location.hostname)) window['ga-disable-{{ site.google_analytics }}'] = true;
    gtag('js', new Date());
{% include ga-site-role.js %}
    gtag('config', '{{ site.google_analytics }}', {
      cookie_domain: 'auto',
      cookie_flags: 'SameSite=None;Secure',
      linker: {
        domains: ['j1yoo.github.io', 'cadi-lab.github.io']
      }
    });
  </script>
  <script defer src="{{ '/assets/js/enhanced-tracking.js' | relative_url }}"></script>
{% endif %}
</body>
</html>
