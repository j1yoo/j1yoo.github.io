  {% include metadata.liquid %}

  <!-- Bootstrap & MDB -->
  <link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}">
  <link rel="stylesheet" href="{{ site.third_party_libraries.mdb.url.css }}" integrity="{{ site.third_party_libraries.mdb.integrity.css }}" crossorigin="anonymous">

  <!-- Fonts & Icons -->
  <link defer rel="stylesheet" type="text/css" href="{{ site.third_party_libraries.google_fonts.url.fonts }}">
  <link defer rel="stylesheet" href="{{ '/assets/css/academicons.min.css' | relative_url | bust_file_cache }}">

  <!-- Site Styles (for theme variables) -->
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_css_cache }}">

  <!-- Dark Mode -->
  <script src="{{ '/assets/js/theme.js' | relative_url | bust_file_cache }}"></script>
  {% if site.enable_darkmode %}
    <script>initTheme();</script>
  {% endif %}

  <!-- Course favicon (per-page favicon_base; defaults to the ECI set) -->
  {% assign fav = page.favicon_base | default: "/assets/courses/eci/eci_favicon" %}
  <link rel="icon" href="{{ fav }}.svg" type="image/svg+xml">
  <link rel="icon" href="{{ fav }}_32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="{{ fav }}_16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="{{ fav }}_apple.png">

  <title>{{ page.title }} · {{ page.semester }}</title>

  <style>
    /* ── Reset: hide main site elements ── */
    body {
      background: var(--global-bg-color) !important;
      margin: 0;
      padding: 0;
    }
    #particles-js { display: none !important; }

    /* ── ECI Navbar ── */
    .eci-navbar {
      background: #2c3e50;
      padding: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      position: sticky;
      top: 0;
      z-index: 1050;
    }
    .eci-navbar .navbar-inner {
      max-width: 960px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1rem;
    }
    .eci-navbar .site-title {
      color: #fff;
      font-weight: 700;
      font-size: 1.1rem;
      text-decoration: none;
      padding: 14px 0;
      white-space: nowrap;
    }
    .eci-navbar .site-title:hover {
      color: rgba(255,255,255,0.85);
      text-decoration: none;
    }
    .eci-navbar .nav-links {
      display: flex;
      align-items: center;
      gap: 0;
    }
    .eci-navbar .nav-links a {
      color: rgba(255,255,255,0.7);
      padding: 14px 16px;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      transition: color 0.15s, background 0.15s;
      border-bottom: 3px solid transparent;
    }
    .eci-navbar .nav-links a:hover {
      color: #fff;
      background: rgba(255,255,255,0.05);
      text-decoration: none;
    }
    .eci-navbar .nav-links a.active {
      color: #fff;
      border-bottom-color: {{ page.accent | default: '#b509ac' }};
    }
    .eci-navbar .nav-links .back-link {
      color: rgba(255,255,255,0.5);
      font-size: 0.8rem;
      border-left: 1px solid rgba(255,255,255,0.15);
      margin-left: 8px;
    }
    .eci-navbar .nav-links .back-link:hover {
      color: rgba(255,255,255,0.8);
    }

    /* ── Mobile hamburger ── */
    .eci-navbar .mobile-toggle {
      display: none;
      background: none;
      border: none;
      color: #fff;
      font-size: 1.4rem;
      cursor: pointer;
      padding: 14px 0;
    }
    @media (max-width: 768px) {
      .eci-navbar .nav-links {
        display: none;
        flex-direction: column;
        width: 100%;
        background: #2c3e50;
      }
      .eci-navbar .nav-links.open {
        display: flex;
      }
      .eci-navbar .nav-links a {
        padding: 12px 20px;
        border-bottom: none;
        border-left: 3px solid transparent;
      }
      .eci-navbar .nav-links a.active {
        border-left-color: {{ page.accent | default: '#b509ac' }};
        border-bottom-color: transparent;
      }
      .eci-navbar .navbar-inner {
        flex-wrap: wrap;
      }
      .eci-navbar .mobile-toggle {
        display: block;
      }
    }

    /* ── Main container ── */
    .eci-container {
      max-width: 960px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* ── Hero ── */
    .eci-hero {
      padding: 2.5rem 0 2rem;
      border-bottom: 3px solid var(--global-divider-color, #dee2e6);
    }
    .eci-hero h1 {
      font-size: 2.3rem;
      font-weight: 700;
      margin-bottom: 0.4rem;
      color: var(--global-text-color);
    }
    .eci-hero .subtitle {
      font-size: 1.2rem;
      color: var(--global-text-color-light);
      margin-bottom: 0.8rem;
    }
    .eci-hero .meta {
      font-size: 0.9rem;
      color: var(--global-text-color-light);
    }
    .eci-hero .meta span {
      margin-right: 1.5rem;
    }
    .eci-hero .meta i {
      color: var(--global-theme-color);
      width: 1.2em;
      text-align: center;
      margin-right: 0.3em;
    }

    /* ── Course logo ── */
    .eci-logo {
      max-width: 130px;
      height: auto;
      display: block;
      border-radius: 12px;
    }
    @media (max-width: 768px) {
      .eci-logo {
        max-width: 120px;
      }
    }

    /* ── Section panels ── */
    .eci-section {
      display: none;
      padding: 2rem 0;
    }
    .eci-section.active {
      display: block;
    }
    #section-overview {
      padding-top: 0;
    }

    /* ── Overview section spacing ── */
    #section-overview h2 + * {
      margin-top: 0;
    }
    #section-overview h2 {
      margin-top: 2.5rem;
    }
    #section-overview h2:first-child {
      margin-top: 0;
    }

    /* ── Course details grid (homepage) ── */
    .course-details {
      padding: 2rem 0;
      border-bottom: 3px solid var(--global-divider-color, #dee2e6);
    }
    .course-details h2 {
      font-size: 1.4rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }
    .info-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .info-list li {
      padding: 4px 0;
      font-size: 0.95rem;
    }
    .info-list i {
      color: var(--global-theme-color);
      width: 1.4em;
      text-align: center;
      margin-right: 0.4em;
    }

    /* ── Feature cards ── */
    .feature-card {
      text-align: center;
      padding: 1.5rem 1rem;
    }
    .feature-card i {
      color: var(--global-theme-color);
      margin-bottom: 0.8rem;
    }
    .feature-card svg {
      color: var(--global-theme-color);
      width: 2em;
      height: 2em;
      margin-bottom: 0.8rem;
      display: inline-block;
    }
    .feature-card h5 {
      font-size: 1rem;
      font-weight: 600;
    }
    .feature-card p {
      font-size: 0.85rem;
      color: var(--global-text-color-light);
    }

    /* ── Materials list ── */
    .materials-list {
      list-style: none;
      padding: 0;
    }
    .materials-list li {
      padding: 10px 0;
      border-bottom: 1px solid var(--global-divider-color, #eee);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .materials-list li:last-child {
      border-bottom: none;
    }
    .materials-buttons {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }

    /* ── Blockquotes (notes) ── */
    .eci-section blockquote {
      font-size: 0.9rem;
      padding: 0.8rem 1rem;
      margin: 1rem 0;
      border-left: 3px solid var(--global-theme-color);
      background: var(--global-bg-color-secondary, #f8f9fa);
    }

    /* ── Section dividers (horizontal rules) ── */
    .eci-section hr {
      border: none;
      border-top: 2px solid var(--global-divider-color, #dee2e6);
      margin: 2.5rem 0;
    }

    /* ── Links (force theme color over al-folio defaults) ── */
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides):not(.eci-nav-link):not(.site-title):not(.back-link),
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides):not(.eci-nav-link):not(.site-title):not(.back-link):visited {
      color: var(--global-theme-color) !important;
    }
    /* Override al-folio's em/strong/span text-color inside links */
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides) em,
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides) strong,
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides) span,
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides) i {
      color: inherit !important;
    }
    body .eci-section a:not(.btn-eci):not(.btn-eci-sm):not(.badge-slides):hover {
      text-decoration: underline !important;
    }
    body .eci-section a.badge-slides,
    body .eci-section a.badge-slides:visited {
      color: #fff !important;
    }

    /* ── Schedule badges ── */
    .eci-section .badge-slides {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 3px;
      margin-right: 4px;
      vertical-align: middle;
      text-decoration: none;
      background: var(--global-theme-color);
      color: #fff !important;
    }
    .eci-section .badge-slides:hover {
      opacity: 0.85;
      text-decoration: none;
    }
    .eci-section .badge-due {
      color: #e74c3c;
      font-weight: 700;
      font-size: 0.85rem;
      margin-right: 0.2em;
    }
    .eci-section .badge-read {
      color: #2980b9;
      font-weight: 700;
      font-size: 0.85rem;
      margin-right: 0.15em;
    }
    .eci-section .badge-read i {
      margin-right: 0.2em;
      font-size: 0.8rem;
    }

    {% if page.permalink == '/teaching/pba/' or page.permalink == '/teaching/pba-grad/' %}
    /* PBA reading labels share typography; color distinguishes preparation. */
    .eci-section .badge-read {
      display: inline-block;
      font-size: 0.9rem;
      white-space: nowrap;
      margin-right: 0.3em;
    }
    .eci-section .badge-read i {
      color: inherit;
      font-size: 0.9em;
      margin-right: 0.3em;
    }
    .eci-section .badge-read-required { color: #b42318; }
    .eci-section .badge-read-optional { color: #626b75; }
    html[data-theme="dark"] .eci-section .badge-read-required { color: #ff938c; }
    html[data-theme="dark"] .eci-section .badge-read-optional { color: #adb5bd; }
    {% endif %}

    /* ── Instructor card ── */
    .instructor-card {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      margin-top: 0.5rem;
    }
    .instructor-card img {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
    .instructor-card .instructor-info {
      flex: 1;
    }
    .instructor-card .instructor-info p {
      margin: 0 0 0.3rem 0;
    }
    @media (max-width: 576px) {
      .instructor-card {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .instructor-card .info-list {
        text-align: left;
      }
    }

    /* ── TA cards (smaller than instructor) ── */
    .ta-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin-top: 0.5rem;
    }
    .ta-card {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      flex: 1 1 260px;
      min-width: 0;
    }
    .ta-card .ta-photo {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
      position: relative;
      display: block;
      cursor: pointer;
    }
    .ta-card .ta-photo img {
      width: 130px;
      height: 130px;
      object-fit: cover;
      position: absolute;
      left: 50%;
      top: 0;
      transform: translateX(-50%);
      transition: transform 0.2s ease, filter 0.2s ease;
    }
    .ta-card .ta-photo:hover img {
      transform: translateX(-50%) scale(1.05);
      filter: brightness(1.1);
    }
    .ta-card .ta-info {
      flex: 1;
      min-width: 0;
    }
    .ta-card .ta-info p {
      margin: 0 0 0.25rem 0;
      font-size: 0.95rem;
      line-height: 1.35;
    }
    .ta-card .ta-info .ta-name {
      font-weight: 600;
    }
    .ta-card .ta-info .ta-affiliation {
      color: #666;
      font-size: 0.88rem;
    }
    .ta-card .ta-info .ta-contact {
      font-size: 0.85rem;
      color: #555;
    }
    @media (max-width: 576px) {
      .ta-grid { flex-direction: column; gap: 1.25rem; }
      .ta-card { flex-direction: row; flex: none; }
    }

    /* ── TA photo lightbox ── */
    img.photo-clickable {
      cursor: pointer;
      transition: transform 0.2s ease, filter 0.2s ease;
    }
    img.photo-clickable:hover {
      transform: scale(1.05);
      filter: brightness(1.1);
    }
    #eciPhotoLightbox {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.85);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
      backdrop-filter: blur(8px);
    }
    #eciPhotoLightbox.active {
      opacity: 1;
      visibility: visible;
    }
    #eciPhotoLightbox .lightbox-close {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      background: none;
      border: none;
      color: #fff;
      font-size: 2rem;
      cursor: pointer;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: background 0.2s;
    }
    #eciPhotoLightbox .lightbox-close:hover { background: rgba(255,255,255,0.15); }
    #eciPhotoLightbox .lightbox-img {
      max-width: 85vw;
      max-height: 85vh;
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
      transform: scale(0.9);
      transition: transform 0.3s ease;
    }
    #eciPhotoLightbox.active .lightbox-img { transform: scale(1); }

    /* ── Schedule parts ── */
    .eci-section h3 {
      font-size: 1.2rem;
      font-weight: 600;
      margin-top: 2rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid var(--global-theme-color);
    }

    /* ── Schedule deliverables ── */
    .schedule-deliverables {
      margin-top: 0.5rem;
      margin-left: 1.2rem;
      padding: 0.4rem 0 0.2rem 0;
      border-top: 1px dashed #ccc;
      font-size: 0.88rem;
      line-height: 1.8;
      color: var(--global-text-color);
    }
    .schedule-deliverables .badge-due {
      font-size: 0.72rem;
      vertical-align: middle;
    }
    .schedule-deliverables .deliv-icon {
      color: var(--global-theme-color);
      width: 1.2em;
      text-align: center;
      margin-right: 0.3em;
      font-size: 0.85rem;
    }

    /* ── Tables ── */
    .eci-section table {
      width: 100%;
      margin: 1rem 0;
    }
    .eci-section table th {
      background: var(--global-theme-color);
      color: #fff;
      padding: 8px 12px;
      font-size: 0.9rem;
    }
    .eval-content table:first-of-type th:first-child,
    .eval-content table:first-of-type td:first-child {
      width: 24%;
    }
    .eval-content table:first-of-type th:nth-child(2),
    .eval-content table:first-of-type td:nth-child(2) {
      width: 10%;
    }
    .eci-section table td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--global-divider-color, #eee);
      font-size: 0.9rem;
    }

    /* ── Video embed ── */
    .video-card {
      margin-bottom: 1.5rem;
      width: 75%;
    }
    .video-card h6 {
      margin-bottom: 0.5rem;
      font-weight: 600;
    }
    .video-responsive {
      position: relative;
      width: 100%;
      padding-bottom: 56.25%; /* 16:9 */
      height: 0;
      overflow: hidden;
    }
    .video-responsive iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    /* ── Shared TOC layout (used by Schedule & Evaluation) ── */
    .toc-layout {
      display: flex;
      gap: 2rem;
    }
    .toc-nav {
      width: 200px;
      flex-shrink: 0;
      position: sticky;
      top: 70px;
      align-self: flex-start;
      max-height: calc(100vh - 90px);
      overflow-y: auto;
      padding-right: 1rem;
      border-right: 1px solid var(--global-divider-color, #dee2e6);
    }
    .toc-nav-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--global-text-color-light);
      margin-bottom: 0.6rem;
    }
    .toc-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .toc-nav li {
      margin-bottom: 0.3rem;
    }
    .toc-nav li a {
      font-size: 0.82rem;
      color: var(--global-text-color-light) !important;
      text-decoration: none;
      display: block;
      padding: 3px 0;
      border-left: 2px solid transparent;
      padding-left: 8px;
      transition: all 0.15s;
    }
    .toc-nav li a:hover {
      color: var(--global-theme-color) !important;
      text-decoration: none !important;
    }
    .toc-nav li a.active {
      color: var(--global-theme-color) !important;
      border-left-color: var(--global-theme-color);
      font-weight: 600;
    }
    .toc-content {
      flex: 1;
      min-width: 0;
    }
    @media (max-width: 768px) {
      .toc-layout {
        flex-direction: column;
      }
      .toc-nav {
        position: static;
        width: 100%;
        max-height: none;
        border-right: none;
        border-bottom: 1px solid var(--global-divider-color, #dee2e6);
        padding-right: 0;
        padding-bottom: 1rem;
        margin-bottom: 1rem;
      }
      .toc-nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem 1rem;
      }
      .toc-nav li a {
        border-left: none;
        padding-left: 0;
      }
    }
    /* Legacy aliases */
    .eval-layout { display: flex; gap: 2rem; }
    .eval-toc { width: 200px; flex-shrink: 0; position: sticky; top: 70px; align-self: flex-start; max-height: calc(100vh - 90px); overflow-y: auto; padding-right: 1rem; border-right: 1px solid var(--global-divider-color, #dee2e6); }
    .eval-content { flex: 1; min-width: 0; }

    /* ── Footer ── */
    .eci-footer {
      text-align: center;
      padding: 2rem 0;
      margin-top: 2rem;
      border-top: 1px solid var(--global-divider-color, #eee);
      font-size: 0.8rem;
      color: var(--global-text-color-light);
    }
    .eci-footer a {
      color: var(--global-theme-color);
    }

    /* ── Buttons ── */
    .btn-eci {
      color: var(--global-text-color);
      border: 1px solid var(--global-text-color);
      background: transparent;
      padding: 6px 14px;
      font-size: 0.85rem;
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.15s;
    }
    .btn-eci:hover {
      color: var(--global-theme-color);
      border-color: var(--global-theme-color);
      text-decoration: none;
    }
    .btn-eci-sm {
      padding: 3px 10px;
      font-size: 0.8rem;
    }
  </style>